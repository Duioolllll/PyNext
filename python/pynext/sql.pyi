from typing import Any

class RawSQL:
    sql: str
    params: tuple[Any, ...] | dict[str, Any]
    def __init__(self, sql: str, params: tuple[Any, ...] | list[Any] | dict[str, Any] = ...) -> None: ...
    def execute(self, connection: Any) -> Any: ...

def raw_sql(sql: str, params: tuple[Any, ...] | list[Any] | dict[str, Any] | None = ...) -> RawSQL: ...
def quote_identifier(name: str) -> str: ...
def validate_ddl_definition(definition: str) -> str: ...
