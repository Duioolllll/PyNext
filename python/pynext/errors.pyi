from typing import Any

from .http import Response as Response

REDIRECT_ERROR_CODE: str
HTTP_ERROR_FALLBACK_ERROR_CODE: str
REDIRECT_STATUSES: frozenset[int]
class SignalError(Exception):
    status: int
    digest: str
    @property
    def label_digest(self) -> str: ...
    def to_response(self) -> Response: ...
class NotFoundError(SignalError):
    def __init__(self, message: str = ...) -> None: ...
class ForbiddenError(SignalError):
    def __init__(self, message: str = ...) -> None: ...
class UnauthorizedError(SignalError):
    def __init__(self, message: str = ...) -> None: ...
class RedirectError(SignalError):
    location: str
    replace: bool
    def __init__(self, location: str, status: int = ..., replace: bool = ...) -> None: ...
def not_found() -> Any: ...
def forbidden() -> Any: ...
def unauthorized() -> Any: ...
def redirect(location: str, status: int = ..., replace: bool = ...) -> Any: ...
def is_signal_error(exc: BaseException) -> bool: ...
def get_digest_for_well_known_error(exc: BaseException) -> str | None: ...
def compute_digest(exc: BaseException) -> str: ...
def digest_for_error(exc: BaseException) -> tuple[str, int]: ...
def error_count(digest: str) -> int: ...
def lookup_error(digest: str) -> dict[str, Any] | None: ...
