from collections.abc import Callable
from dataclasses import dataclass
from typing import Any, TypeVar
from .http import Request, Response
_F = TypeVar("_F", bound=Callable[..., Any])
@dataclass(frozen=True)
class AuthorizationPolicy:
    requires_auth: bool = ...
    permissions: tuple[str, ...] = ...
    scopes: tuple[str, ...] = ...
def authorization_policy(fn: Callable[..., Any]) -> AuthorizationPolicy: ...
def require_auth(fn: _F) -> _F: ...
def require_permission(permission: str) -> Callable[[_F], _F]: ...
def require_scope(*scopes: str) -> Callable[[_F], _F]: ...
def check_authorization(request: Request, fn: Callable[..., Any], *, policy: AuthorizationPolicy | None = ...) -> Response | None: ...
