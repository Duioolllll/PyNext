from collections.abc import Callable
from dataclasses import dataclass
from typing import Any, TypeVar
from .http import Request, Response
_F = TypeVar("_F", bound=Callable[..., Any])
@dataclass(frozen=True)
class AuthorizationPolicy:
    requires_auth: bool = ...
    permissions: tuple[str, ...] = ...
    scopes: tuple[str, ...] = ...
def authorization_policy(fn: Callable[..., Any]) -> AuthorizationPolicy: ...
LOGIN_MAX_FAILURES: int
LOGIN_BLOCK_SECONDS: int
LOGIN_MAX_KEYS: int
class LoginRateLimiter:
    max_failures: int
    block_seconds: float
    max_keys: int
    def __init__(self, max_failures: int = ..., block_seconds: float = ..., *, max_keys: int | None = ...) -> None: ...
    def retry_after(self, client_ip: str | None, account: str, *, now: float | None = ...) -> int | None: ...
    def is_blocked(self, client_ip: str | None, account: str, *, now: float | None = ...) -> bool: ...
    def check_login(self, client_ip: str | None, account: str, *, now: float | None = ...) -> Response | None: ...
    def record_failure(self, client_ip: str | None, account: str, *, now: float | None = ...) -> int | None: ...
    def record_success(self, client_ip: str | None, account: str) -> None: ...
    def stats(self) -> dict[str, int]: ...
    def reset(self) -> None: ...
def require_auth(fn: _F) -> _F: ...
def require_permission(permission: str) -> Callable[[_F], _F]: ...
def require_scope(*scopes: str) -> Callable[[_F], _F]: ...
def check_authorization(request: Request, fn: Callable[..., Any], *, policy: AuthorizationPolicy | None = ...) -> Response | None: ...
