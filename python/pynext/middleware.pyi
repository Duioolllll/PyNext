from collections.abc import Iterable, Mapping
from dataclasses import dataclass
from typing import Any, Final, Literal, Protocol, overload
from .http import Request, Response
from .types import Middleware, NextHandler

@dataclass(frozen=True)
class RouteHas:
    type: Literal["header", "query", "cookie", "host"]
    key: str | None = ...
    value: str | None = ...
    def matches(self, request: Request) -> bool: ...

@dataclass(frozen=True)
class MiddlewareScope:
    source: str | None = ...
    has: tuple[RouteHas, ...] = ...
    missing: tuple[RouteHas, ...] = ...
    def matches(self, request: Request) -> bool: ...

class ScopedMiddleware:
    middleware: Middleware
    scope: MiddlewareScope
    def __init__(self, middleware: Middleware, scope: MiddlewareScope) -> None: ...
    async def __call__(self, request: Request, call_next: NextHandler) -> Response | MiddlewareResult: ...

def scoped(middleware: Middleware, *, source: str | None = ...,
           has: RouteHas | Mapping[str, Any] | Iterable[RouteHas | Mapping[str, Any]] = ...,
           missing: RouteHas | Mapping[str, Any] | Iterable[RouteHas | Mapping[str, Any]] = ...) -> ScopedMiddleware: ...

MAX_MIDDLEWARE_REWRITES: Final[int]
REDIRECT_STATUSES: Final[frozenset[int]]
type MiddlewareKind = Literal["next", "rewrite", "redirect", "response"]

def is_redirect_response(response: Response) -> bool: ...
def classify_response(response: Response) -> MiddlewareKind: ...
def redirect_response(location: str, status: int = ...) -> Response: ...
def rewrite_request(request: Request, path: str,
                    query_string: str | bytes | bytearray | memoryview | None = ...) -> Request: ...

class _MiddlewareResponseFactory(Protocol):
    def __call__(self, response: Response) -> MiddlewareResult: ...

class _MiddlewareResponseAccessor:
    # The runtime installs a class factory while instances retain their
    # response dataclass field. Preserve both access forms in the stub.
    @overload
    def __get__(self, instance: None, owner: type[MiddlewareResult]) -> _MiddlewareResponseFactory: ...
    @overload
    def __get__(self, instance: MiddlewareResult, owner: type[MiddlewareResult] | None = ...) -> Response | None: ...

@dataclass(frozen=True)
class MiddlewareResult:
    kind: MiddlewareKind
    request: Request | None = ...
    response: _MiddlewareResponseAccessor = ...
    def __init__(self, kind: MiddlewareKind, request: Request | None = ..., response: Response | None = ...) -> None: ...
    @property
    def is_terminal(self) -> bool: ...
    @property
    def is_continue(self) -> bool: ...
    @classmethod
    def next(cls, request: Request) -> MiddlewareResult: ...
    @classmethod
    def rewrite(cls, request: Request) -> MiddlewareResult: ...
    @classmethod
    def redirect(cls, location: str, status: int = ...) -> MiddlewareResult: ...
