from types import TracebackType
from typing import Self
class PubSubOverflow(Exception): ...
class _Subscription:
    def __init__(self, broker: WebSocketPubSub, topic: str) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(self, exc_type: type[BaseException] | None, exc: BaseException | None,
                        traceback: TracebackType | None) -> None: ...
    async def receive(self) -> str | bytes: ...
    async def close(self) -> None: ...
class WebSocketPubSub:
    def __init__(self, *, queue_size: int = ..., max_topics: int = ..., max_subscribers: int = ...,
                 max_message_bytes: int = ...) -> None: ...
    def subscribe(self, topic: str) -> _Subscription: ...
    async def publish(self, topic: str, message: str | bytes) -> int: ...
