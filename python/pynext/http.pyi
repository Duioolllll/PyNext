from collections.abc import AsyncIterable, Awaitable, Callable, Iterable, Mapping
from dataclasses import dataclass, field
from threading import Event
from typing import Any, Literal, TypeVar, overload
from .app import App
from .forms import UploadFile
from .types import Headers, JSONValue, Params, Resource

_F = TypeVar("_F", bound=Callable[..., Any])
_R = TypeVar("_R", bound=Response)
class BadRequest(Exception): ...
class RequestCancelled(RuntimeError): ...

@dataclass(frozen=True)
class SecurityConfig:
    csrf_enabled: bool | None = ...
    csrf_cookie_name: str = ...
    csrf_header_name: str = ...
    csrf_form_field: str = ...
    csrf_cookie_secure: bool = ...
    csrf_cookie_samesite: str = ...
    cors_allowed_origins: tuple[str, ...] = ...
    cors_allowed_methods: tuple[str, ...] = ...
    cors_allowed_headers: tuple[str, ...] = ...
    cors_allow_credentials: bool = ...
    cors_max_age: int = ...
    csp_nonce_enabled: bool = ...
    csrf_signing_key: str | bytes | None = ...
    csrf_origin_check: bool = ...
    csrf_trusted_origins: tuple[str, ...] = ...
    hsts_enabled: bool = ...
    hsts_max_age: int = ...
    hsts_include_subdomains: bool = ...
    hsts_preload: bool = ...
    frame_options: str | None = ...
    referrer_policy: str | None = ...
    permissions_policy: str | None = ...
    csp_style_src: str = ...
    csp_frame_ancestors: str = ...
    csp_base_uri: str = ...
    csp_form_action: str = ...
    websocket_allowed_origins: tuple[str, ...] = ...
    websocket_allow_missing_origin: bool = ...

@dataclass(frozen=True)
class Request:
    method: str
    path: str
    query_string: bytes = ...
    headers: tuple[tuple[bytes, bytes], ...] = ...
    body: bytes = ...
    params: Params = ...
    _app: App | None = ...
    state: dict[str, Any] = ...
    _cancel_event: Event = ...
    raw_path: str = ...
    @property
    def cancelled(self) -> bool: ...
    def check_cancelled(self) -> None: ...
    @property
    def resources(self) -> Mapping[str, Resource]: ...
    @property
    def security(self) -> SecurityConfig: ...
    async def revalidate(self, path: str, type: str | None = ...) -> bool: ...
    async def revalidate_tag(self, tag: str, expire: float | None = ...) -> bool: ...
    @property
    def query(self) -> dict[str, list[str]]: ...
    async def json(self) -> JSONValue: ...
    async def form(self) -> dict[str, list[str | UploadFile]]: ...

class Response:
    body: bytes
    status: int
    headers: list[tuple[bytes, bytes]]
    def __init__(self, body: str | bytes | bytearray | memoryview = ..., *, status: int = ...,
                 headers: Headers = ..., media_type: str | None = ..., csp_nonce: str | None = ...) -> None: ...
class JSONResponse(Response):
    def __init__(self, value: JSONValue, *, status: int = ..., headers: Headers = ...) -> None: ...
class StreamingResponse(Response):
    def __init__(self, content: AsyncIterable[str | bytes], *, status: int = ...,
                 headers: Headers = ..., media_type: str = ...) -> None: ...
    async def aclose(self) -> None: ...

MAX_WS_MESSAGE: int
class WebSocketDisconnect(Exception):
    code: int
    reason: str
    def __init__(self, code: int = ..., reason: str = ...) -> None: ...
class WebSocket:
    path: str
    params: Params
    headers: tuple[tuple[bytes, bytes], ...]
    query_string: bytes
    max_message_bytes: int
    subprotocol: str | None
    offered_subprotocols: tuple[str, ...]
    def __init__(self, *, receive: Callable[[], Awaitable[tuple[Literal["text"], str] | tuple[Literal["bytes"], bytes]]],
                 send: Callable[[tuple[Any, ...]], Awaitable[None]], path: str, params: Params | None = ...,
                 headers: Headers = ..., query_string: bytes = ..., max_message_bytes: int = ...,
                 subprotocol: str | None = ..., offered_subprotocols: Iterable[str] = ...) -> None: ...
    @property
    def accepted(self) -> bool: ...
    @property
    def closed(self) -> bool: ...
    @property
    def query(self) -> dict[str, list[str]]: ...
    async def accept(self) -> None: ...
    async def send_text(self, data: str) -> None: ...
    async def send_bytes(self, data: bytes) -> None: ...
    async def receive(self) -> tuple[Literal["text"], str] | tuple[Literal["bytes"], bytes]: ...
    async def receive_text(self) -> str: ...
    async def receive_bytes(self) -> bytes: ...
    async def close(self, code: int = ..., reason: str = ...) -> None: ...

def new_csrf_token() -> str: ...
def mask_csrf_token(token: str) -> str: ...
def unmask_csrf_token(masked: str) -> str | None: ...
def sign_csrf_token(token: str, *, config: SecurityConfig = ...) -> str: ...
INTERNAL_HEADERS: frozenset[bytes]
def filter_internal_headers(headers: Headers) -> tuple[tuple[bytes, bytes], ...]: ...
def set_csrf_cookie(response: _R, token: str, *, config: SecurityConfig = ...) -> _R: ...
def validate_csrf(request: Request, *, config: SecurityConfig = ...) -> bool: ...
def csrf_protect(fn: _F) -> _F: ...
def get_csrf_token(request: Request, *, config: SecurityConfig = ...) -> str: ...
def csrf_token_response(request: Request, *, config: SecurityConfig = ...) -> JSONResponse: ...
def csrf_input(request: Request, response: _R | None = ..., *, config: SecurityConfig = ...) -> str: ...
def new_csp_nonce() -> str: ...
def content_security_policy(nonce: str | None = ..., *, config: SecurityConfig = ...) -> str: ...
def security_headers(*, config: SecurityConfig = ..., nonce: str | None = ..., production: bool = ...) -> list[tuple[bytes, bytes]]: ...
def apply_security_headers(response: _R, *, config: SecurityConfig = ..., nonce: str | None = ..., production: bool = ...) -> _R: ...

@dataclass(frozen=True)
class PathHeaderRule:
    source: str
    headers: tuple[tuple[str, str], ...] = ...
    _regex: object = ...
    def matches(self, path: str) -> bool: ...

class PathHeaders:
    rules: tuple[PathHeaderRule, ...]
    def __init__(self, rules: Iterable[PathHeaderRule] = ...) -> None: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def headers_for(self, path: str) -> tuple[tuple[bytes, bytes], ...]: ...
    def for_native(self) -> tuple[tuple[str, tuple[tuple[bytes, bytes], ...]], ...]: ...

PathHeaderRuleInput = PathHeaderRule | tuple[str, Mapping[str, str] | Iterable[tuple[str, str]]]
def compile_path_headers(rules: Iterable[PathHeaderRuleInput] | None = ...) -> PathHeaders: ...
def apply_path_headers(response: _R, path: str, *, path_headers: PathHeaders | None = ...) -> _R: ...
