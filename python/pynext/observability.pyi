from dataclasses import dataclass
from typing import Any, Callable
import re
SECRET_MASK: str
SENSITIVE_POST_PARAM_RE: re.Pattern[str]
SLOT_WAIT_BUCKETS_MS: tuple[float, ...]
QUEUE_DEPTH_BUCKETS: tuple[int, ...]
def is_sensitive_key(name: object) -> bool: ...
def scrub_post_parameters(params: dict[str, Any], extra_sensitive: tuple[str, ...] = ...) -> dict[str, Any]: ...
def scrub_text(text: str) -> str: ...
def scrub_log_value(value: Any, _depth: int = ...) -> Any: ...
def scrub_locals(func: Callable[..., Any] | None, local_vars: dict[str, Any]) -> dict[str, Any]: ...
def sensitive_variables(*names: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]: ...
def sensitive_post_parameters(*names: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]: ...
@dataclass
class ObservabilityConfig:
    structured_logs: bool = ...
    metrics: bool = ...
    tracing: bool = ...
    log_level: str = ...
    request_insights: bool | None = ...
    request_insights_max: int = ...
    request_insights_slow_ms: float | None = ...
    metrics_endpoint: bool = ...
    log_dedup_window_s: float = ...
    backend_health_ttl_s: float = ...
    @classmethod
    def from_env(cls) -> ObservabilityConfig: ...
class MetricsCollector:
    enabled: bool
    def __init__(self, enabled: bool = ...) -> None: ...
    def observe_request(self, route: str, method: str, status: int, latency_ms: float,
                        response_bytes: int = ..., queue_wait_ms: float | None = ...,
                        python_ms: float | None = ..., rust_ms: float | None = ...) -> None: ...
    def observe_render(self, rust_ms: float) -> None: ...
    def observe_queue_enter(self) -> None: ...
    def observe_queue_exit(self) -> None: ...
    def observe_sync_workers(self, active: int, capacity: int | None = ...) -> None: ...
    def observe_worker_start(self) -> None: ...
    def observe_worker_timeout(self, kind: str = ...) -> None: ...
    def observe_rate_limit_fail_open(self) -> None: ...
    def observe_stage_timeout(self, stage: str) -> None: ...
    def observe_cache(self, outcome: str) -> None: ...
    def observe_regeneration(self, outcome: str) -> None: ...
    def observe_error(self, route: str, error_type: str, digest: str | None = ...) -> None: ...
    def observe_rate_limit(self, outcome: str) -> None: ...
    def observe_middleware(self, outcome: str) -> None: ...
    def observe_warmup(self, result: dict[str, Any]) -> None: ...
    def observe_island_bundle(self, path: str, size_bytes: int) -> None: ...
    def snapshot(self) -> dict[str, Any]: ...
    def prometheus_text(self) -> str: ...
class RequestInsights:
    enabled: bool
    max_entries: int
    slow_threshold_ms: float | None
    def __init__(self, enabled: bool = ..., max_entries: int = ...,
                 slow_threshold_ms: float | None = ...) -> None: ...
    def observe(self, *, request_id: str | None, method: str, route: str, status: int,
                latency_ms: float, python_ms: float | None = ..., rust_ms: float | None = ...,
                queue_wait_ms: float | None = ..., error_type: str | None = ...) -> None: ...
    def clear(self) -> None: ...
    def snapshot(self) -> dict[str, Any]: ...
    def observe_degraded(self, component: str, policy: str, outcome: str) -> None: ...
    def observe_island_bundle(self, path: str, size_bytes: int) -> None: ...
    def snapshot(self) -> dict[str, Any]: ...
    def prometheus_text(self) -> str: ...
class BackendHealth:
    def __init__(self, ttl_s: float = ..., *, clock: Any = ...) -> None: ...
    def set_ttl(self, ttl_s: float) -> None: ...
    def report(self, component: str, *, healthy: bool, policy: str) -> None: ...
    def snapshot(self) -> dict[str, dict[str, Any]]: ...
    def unhealthy_fail_closed(self) -> list[str]: ...
    def degraded(self) -> list[str]: ...
class DedupedErrorLogger:
    def __init__(self, logger: Any = ..., window_s: float = ..., *, clock: Any = ...) -> None: ...
    def set_window(self, window_s: float) -> None: ...
    @property
    def suppressed_counts(self) -> dict[Any, int]: ...
    def log_exception(self, exc: BaseException, *, route: str | None = ...) -> None: ...
def classify_request_error(exc: BaseException) -> str: ...
