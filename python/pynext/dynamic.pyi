from collections.abc import Callable
from datetime import datetime, tzinfo
from typing import Any, Literal

DYNAMIC_DIGEST: str
DYNAMIC_MODES: tuple[str, ...]
MAX_DYNAMIC_ACCESSES: int

class DynamicAccess:
    expression: str
    kind: Literal["data", "intent"]
    location: str
    stack: list[str]
    def __init__(self, expression: str, kind: str, location: str, stack: list[str]) -> None: ...
    def to_dict(self) -> dict[str, Any]: ...

def format_dynamic_accesses(accesses: list[DynamicAccess]) -> str: ...

class StaticGenBailoutError(ValueError):
    digest: str
    pattern: str
    expression: str
    accesses: list[DynamicAccess]
    def __init__(self, pattern: str, expression: str, accesses: list[DynamicAccess]) -> None: ...

def is_prerender_bailout(error: BaseException) -> bool: ...

class DynamicTrackingState:
    pattern: str
    dynamic_mode: str
    accesses: list[DynamicAccess]
    dropped: int
    closed: bool
    def __init__(self, pattern: str, dynamic_mode: str) -> None: ...
    @property
    def should_error(self) -> bool: ...
    def record(self, expression: str, *, kind: Literal["data", "intent"] = ...) -> DynamicAccess | None: ...
    def close(self) -> None: ...

def mark_dynamic_access(expression: str, *, kind: Literal["data", "intent"] = ...) -> DynamicAccess | None: ...
def no_store() -> DynamicAccess | None: ...
def now(tz: tzinfo | None = ...) -> datetime: ...
def utcnow() -> datetime: ...
def suppress_dynamic_tracking() -> Any: ...

class PrerenderTracker:
    pattern: str
    dynamic_mode: str
    state: DynamicTrackingState
    def __init__(self, pattern: str, dynamic_mode: str, *,
                 on_finish: Callable[[DynamicTrackingState], None] | None = ...) -> None: ...
    def __enter__(self) -> DynamicTrackingState: ...
    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> bool: ...

def track_prerender(pattern: str, dynamic_mode: str, *,
                    on_finish: Callable[[DynamicTrackingState], None] | None = ...) -> PrerenderTracker: ...
