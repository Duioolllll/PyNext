from typing import Any
from .http import Response

class CustomRoutes:
    def __bool__(self) -> bool: ...
    def match_redirect(self, path: str) -> tuple[int, str] | None: ...
    def match_rewrite(self, path: str, phase: str) -> str | None: ...
    def headers_for(self, path: str) -> list[tuple[str, str]]: ...
    def apply_to_response(self, response: Response, path: str) -> None: ...

def compile_custom_routes(config: dict[str, Any] | None) -> CustomRoutes: ...
