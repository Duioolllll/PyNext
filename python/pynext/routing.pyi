from collections.abc import Callable, Iterable
from typing import Any, Literal, TypeVar, overload
_F = TypeVar("_F", bound=Callable[..., Any])
def route(method: Literal["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]) -> Callable[[_F], _F]: ...
def state_changing_get(fn: _F) -> _F: ...
def url_for(pattern: str, params: dict[str, Any], *, router: Any = ..., base_path: str = ...) -> str: ...
@overload
def websocket(fn: _F, *, protocols: Iterable[str] = ...) -> _F: ...
@overload
def websocket(fn: None = ..., *, protocols: Iterable[str] = ...) -> Callable[[_F], _F]: ...
def normalize_base_path(value: str) -> str: ...
def validate_trailing_slash(value: str) -> Literal["redirect", "ignore"]: ...
def preprocess_pathname(path: str, *, base_path: str = ...,
                        trailing_slash: Literal["redirect", "ignore"] = ...) -> str | None: ...
def add_base_path(path: str, base_path: str = ...) -> str: ...
