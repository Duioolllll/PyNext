from collections.abc import Iterable
from .http import Response
from .types import ProxyEntry
from .types import Headers
class RateLimitUnavailable(Exception): ...
class RateLimiter:
    limit: int
    window_seconds: float
    ipv6_prefix_len: int
    trusted_proxies: tuple[ProxyEntry, ...]
    def __init__(self, limit: int, window_seconds: float, *, trusted_proxies: Iterable[ProxyEntry] = ...,
                 exempt_paths: Iterable[str] = ..., max_buckets: int | None = ...,
                 max_new_keys_per_window: int | None = ..., ipv6_prefix_len: int = ...) -> None: ...
    def is_exempt(self, path: str) -> bool: ...
    def key_for(self, client_ip: str | None, headers: Headers = ...) -> str: ...
    def stats(self) -> dict[str, int | None]: ...
    def allow(self, key: str, *, now: float | None = ...) -> tuple[bool, float | None]: ...
    def reset(self) -> None: ...
def rate_limited_response(retry_after: float) -> Response: ...
