from collections.abc import Iterable, Iterator, MutableMapping, Sequence
from concurrent.futures import ThreadPoolExecutor
from os import PathLike
from typing import Any, Literal, Protocol
from .http import Request, Response
from .types import JSONValue, NextHandler, SessionStore as _SessionStore

class SessionConflict(Exception): ...
class SessionUnavailable(Exception): ...

_SessionKey = bytes | str
class SessionPayloadCipher:
    def __init__(self, keys: Sequence[bytes]) -> None: ...
    def seal(self, plaintext: bytes, token: str) -> str: ...
    def unseal(self, sealed_text: str, token: str) -> bytes: ...
class SessionRecord(tuple[dict[str, JSONValue], str | None, int]):
    created_at: float
    last_seen: float
    def __new__(cls, data: dict[str, JSONValue], csrf: str | None, version: int, *,
                created_at: float, last_seen: float) -> SessionRecord: ...
class SQLiteSessionStore:
    executor: ThreadPoolExecutor | None
    def __init__(self, path: str | PathLike[str], executor: ThreadPoolExecutor | None = ..., *, encryption_key: _SessionKey | None = ...,
                 encryption_keys: Iterable[_SessionKey] | None = ...) -> None: ...
    async def load(self, token: str) -> SessionRecord | None: ...
    async def save(self, token: str, data: dict[str, JSONValue], csrf: str | None, version: int | None,
                   expires: float, *, previous_token: str | None = ...) -> int: ...
    async def delete(self, token: str) -> None: ...
    async def purge_expired(self) -> None: ...
class RedisSessionStore:
    def __init__(self, url: str | None = ..., *, client: Any = ..., key_prefix: str = ...,
                 failure_policy: Literal["fail_open", "fail_closed"] | None = ...,
                 encryption_key: _SessionKey | None = ...,
                 encryption_keys: Iterable[_SessionKey] | None = ...,
                 max_pending_revocations: int = ...) -> None: ...
    def close(self) -> None: ...
    @property
    def pending_revocations(self) -> tuple[str, ...]: ...
    async def flush_pending_revocations(self) -> tuple[int, int]: ...
    async def load(self, token: str) -> SessionRecord | None: ...
    async def save(self, token: str, data: dict[str, JSONValue], csrf: str | None, version: int | None,
                   expires: float, *, previous_token: str | None = ...) -> int: ...
    async def delete(self, token: str) -> bool: ...
    async def purge_expired(self) -> None: ...
class Session(MutableMapping[str, JSONValue]):
    def __init__(self, data: dict[str, JSONValue] | None = ..., csrf: str | None = ...,
                 token: str | None = ..., version: int | None = ...) -> None: ...
    def __getitem__(self, key: str) -> JSONValue: ...
    def __setitem__(self, key: str, value: JSONValue) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def csrf_token(self) -> str: ...
    def rotate(self) -> None: ...
    def rotate_on_login(self) -> None: ...
    def cycle_key(self) -> None: ...
    def invalidate(self) -> None: ...
    def flush(self) -> None: ...
    def issue_single_use_token(self, purpose: str, *, max_age: int = ...) -> str: ...
    def verify_single_use_token(self, purpose: str, submitted: str) -> bool: ...
    def mark_authenticated(self) -> None: ...
    @property
    def authenticated_at(self) -> float | None: ...
    def recently_authenticated(self, max_age: int = ...) -> bool: ...
class SessionMiddleware:
    def __init__(self, store: _SessionStore, *, cookie_name: str = ..., secure: bool = ...,
                 same_site: Literal["Lax", "Strict", "None"] = ..., max_age: int = ...,
                 idle_timeout: int | None = ..., absolute_max_age: int = ...,
                 touch_interval: float | None = ...,
                 purge_interval: float | None = ...) -> None: ...
    async def close(self) -> None: ...
    async def __call__(self, request: Request, call_next: NextHandler) -> Response: ...
