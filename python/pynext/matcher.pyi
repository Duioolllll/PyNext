import re
from collections.abc import Mapping
from dataclasses import dataclass, field
from typing import Any

MAX_MATCHER_LENGTH: int
MAX_HAS_VALUE_LENGTH: int
MAX_HEADER_VALUE_LENGTH: int
MAX_HEADER_RULES: int

@dataclass(frozen=True)
class Matcher:
    source: str
    regex: re.Pattern[str] = field(repr=False)
    param_names: tuple[str, ...] = ...
    def matches(self, path: str) -> dict[str, str] | None: ...

@dataclass(frozen=True)
class HasCondition:
    type: str
    key: str | None
    value: str | None = ...
    def matches(self, *, headers: tuple[tuple[bytes, bytes], ...] = ...,
                query: dict[str, list[str]] | None = ...,
                cookies: dict[str, str] | None = ..., host: str = ...) -> bool: ...

@dataclass(frozen=True)
class Scope:
    matcher: Matcher | None
    has: tuple[HasCondition, ...] = ...
    missing: tuple[HasCondition, ...] = ...
    def matches(self, path: str, *, headers: tuple[tuple[bytes, bytes], ...] = ...,
                query: dict[str, list[str]] | None = ...,
                cookies: dict[str, str] | None = ..., host: str = ...) -> bool: ...
    def matches_request(self, request: Any) -> bool: ...

@dataclass(frozen=True)
class HeaderRule:
    source: str
    matcher: Matcher
    headers: tuple[tuple[bytes, bytes], ...] = ...
    has: tuple[HasCondition, ...] = ...
    missing: tuple[HasCondition, ...] = ...
    def matches(self, path: str, *, headers: tuple[tuple[bytes, bytes], ...] = ...,
                query: dict[str, list[str]] | None = ...,
                cookies: dict[str, str] | None = ..., host: str = ...) -> bool: ...
    def matches_request(self, request: Any) -> bool: ...

class ScopedMiddleware:
    middleware: Any
    scope: Scope
    def __init__(self, middleware: Any, scope: Scope) -> None: ...
    async def __call__(self, request: Any, call_next: Any) -> Any: ...

def compile_matcher(source: str) -> Matcher: ...
def compile_has_condition(spec: Mapping[str, Any]) -> HasCondition: ...
def compile_scope(match: str | None = ..., has: Any = ..., missing: Any = ...) -> Scope: ...
def compile_header_rules(rules: Any) -> tuple[HeaderRule, ...]: ...
def compile_middleware_entries(entries: Any) -> tuple[tuple[Any, Scope | None], ...]: ...
def scoped_middleware(middleware: Any = ..., *, match: str | None = ...,
                      has: Any = ..., missing: Any = ...) -> Any: ...
